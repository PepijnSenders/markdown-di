{
  "name": "@markdown-di/core",
  "version": "0.12.0",
  "description": "Parser-agnostic dependency injection for markdown using frontmatter",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js"
    },
    "./modules/node": {
      "types": "./dist/modules/node.d.ts",
      "import": "./dist/modules/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LLMS.txt"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && bun build ./src/modules/index.ts ./src/modules/node.ts --outdir ./dist/modules --target node --format esm --packages external --splitting && tsc --emitDeclarationOnly",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "markdown",
    "frontmatter",
    "dependency-injection",
    "validation",
    "parser-agnostic"
  ],
  "author": "Pepijn Senders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PepijnSenders/markdown-di.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@types/mustache": "4.2.6",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "mustache": "4.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
