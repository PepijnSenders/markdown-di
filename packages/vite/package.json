{
  "name": "@markdown-di/vite",
  "version": "0.12.1",
  "type": "module",
  "description": "Vite plugin for markdown-di - import .md files as typed, strict render functions, typed data, or collections",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./md-modules": {
      "types": "./md-modules.d.ts"
    }
  },
  "files": [
    "dist",
    "md-modules.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/runtime.ts --outdir ./dist --target node --format esm --packages external --splitting && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "markdown",
    "vite",
    "vite-plugin",
    "frontmatter",
    "prompts",
    "data"
  ],
  "author": "Pepijn Senders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PepijnSenders/markdown-di.git",
    "directory": "packages/vite"
  },
  "dependencies": {
    "@markdown-di/core": "workspace:^"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.3"
  }
}
